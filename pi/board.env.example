# Copy to board.env and fill in. Keep board.env private: chmod 600 board.env

# The same two values as in config.js.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY=PASTE_YOUR_PUBLISHABLE_KEY

# The user you sign in to the board with.
BOARD_EMAIL=you@example.com
BOARD_PASSWORD=your-board-password

# Optional.
BOARD_TITLE=Board
# Column ids and names, first = not started, last = done. Match config.js.
BOARD_COLUMNS=todo:To do,doing:In progress,review:Review,done:Done
BOARD_POLL_SECONDS=60
# 180 or 0, depending on which way up the screen sits.
BOARD_ROTATION=180
# Lower this (for example 10) if the picture glitches on a ribbon cable.
BOARD_SPI_MHZ=30
